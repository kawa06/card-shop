# Copy this file to .env and fill in your values

# App (set DEBUG=True for local development without Resend/Twilio)
DEBUG=False

# Database (SQLite for local dev, Railway provides PostgreSQL URL in production)
# IMPORTANT: Production MUST use PostgreSQL. SQLite data is lost on every redeploy.
DATABASE_URL=sqlite:///./card_shop.db

# JWT — set a stable random string in Railway (required for production)
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated list)
# Phase 3+: add buylist origin, e.g. https://card-vault-public.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Frontend URL for email verification links
FRONTEND_URL=https://frontend-one-topaz-20.vercel.app

# Buylist site URL (Phase 3+ CORS / email links)
BUYLIST_URL=https://card-vault-public.vercel.app

# Email (Gmail SMTP — primary; Resend optional fallback)
RESEND_API_KEY=re_xxxxxxxx
MAIL_USERNAME=oripakawa@gmail.com
MAIL_FROM=oripakawa@gmail.com
# Google App Password for oripakawa@gmail.com (required for sending)
MAIL_PASSWORD=
MAIL_REPLY_TO=oripakawa@gmail.com
MAIL_FROM_NAME=KRX TCG

# Optional: seed shop_settings on first deploy (DB is source of truth after migrate)
INVOICE_REGISTRATION_NUMBER=
INVOICE_ISSUER_NAME=

# Phone verification (Twilio Verify) - required in production
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx

# Clerk (optional direct JWT auth; admin proxy uses AUTH_SYNC_SECRET below)
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxx

# Shared secret with Vercel backend-sync (required for Clerk → JWT sync)
AUTH_SYNC_SECRET=your-random-secret-at-least-32-chars

# Admin API proxy secret (must match Vercel ADMIN_PROXY_SECRET — server-side only)
ADMIN_PROXY_SECRET=your-random-admin-proxy-secret

# Stripe (credit card payments)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# --- Buyback (Phase 3+) ---

# Cloudflare R2 (private KYC document storage — Phase 6)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
# Option A: R2 S3-compatible credentials (32-char Access Key ID from R2 dashboard)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Option B: Cloudflare User/Account API token with R2 bucket write (preferred if S3 keys unavailable)
R2_API_TOKEN=

# Payout account encryption (32+ byte secret for field-level encryption)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set on Railway backend service only — never expose to frontend or git
BUYBACK_PAYOUT_ENCRYPTION_KEY=

# Optional buyback print / ラベル屋さん overrides (defaults: KRX TCG / 72265)
BUYBACK_SHOP_NAME=
BUYBACK_LABEL_PRODUCT_CODE=

# Optional Firestore read fallback during price migration
FIRESTORE_BUYLIST_PROJECT_ID=
FIRESTORE_BUYLIST_CREDENTIALS_JSON=

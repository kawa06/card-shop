# Copy this file to .env and fill in your values

# App (set DEBUG=True for local development without Resend/Twilio)
DEBUG=False

# Database (SQLite for local dev, Railway provides PostgreSQL URL in production)
# IMPORTANT: Production MUST use PostgreSQL. SQLite data is lost on every redeploy.
DATABASE_URL=sqlite:///./card_shop.db

# JWT — set a stable random string in Railway (required for production)
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Frontend URL for email verification links
FRONTEND_URL=https://frontend-one-topaz-20.vercel.app

# Email verification (Resend) - required in production
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=noreply@oripa-kawa.com
MAIL_FROM_NAME=KRX TCG

# Phone verification (Twilio Verify) - required in production
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx

# Clerk (optional direct JWT auth; admin proxy uses AUTH_SYNC_SECRET below)
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxx

# Shared secret with Vercel (required for admin API proxy)
AUTH_SYNC_SECRET=your-random-secret-at-least-32-chars

# Stripe (credit card payments)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

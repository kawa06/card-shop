# Clerk Auth（本番は pk_live_ / sk_live_ を Vercel Production に設定）
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/after-sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/after-sign-in

# バックエンドAPIとの同期用（32文字以上のランダム文字列）
AUTH_SYNC_SECRET=your-random-secret-at-least-32-chars

# バックエンドAPI URL（省略時は next.config.js のデフォルト）
# NEXT_PUBLIC_API_URL=https://backend-production-054e.up.railway.app

# 買取表サイト URL（ヘッダー「オンライン買取」リンク）
NEXT_PUBLIC_BUYLIST_URL=https://card-vault-public.vercel.app
